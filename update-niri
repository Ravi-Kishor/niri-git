#!/usr/bin/env bash
set -euo pipefail

REPO="Ravi-Kishor/niri-git"
PKG_NAME="niri-git"

AUTO_YES=false
FORCE=false

# -------------------------------
# Parse Arguments
# -------------------------------
for arg in "$@"; do
  case "$arg" in
    -y|--yes) AUTO_YES=true ;;
    -f|--force) FORCE=true ;;
    -h|--help)
      echo "Usage: $(basename "$0") [-y|--yes] [-f|--force]"
      exit 0
      ;;
  esac
done

# -------------------------------
# Dependency Check
# -------------------------------
require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "❌ Missing dependency: $1"
    exit 1
  }
}

for cmd in curl jq pacman sudo aria2c vercmp sha256sum; do
  require "$cmd"
done

# -------------------------------
# Version Check
# -------------------------------
INSTALLED_VERSION="$(pacman -Q "$PKG_NAME" 2>/dev/null | awk '{print $2}' || true)"

echo "------------------------------------------"
echo "  Niri Installer (Zen3 build)"
echo "------------------------------------------"
echo "Local:   ${INSTALLED_VERSION:-Not Installed}"
echo "📡 Fetching latest release..."

RELEASE_JSON="$(curl -fsSL \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$REPO/releases/latest")"

# Exclude -debug split packages and select the main x86_64/znver3 package
ASSET_JSON="$(jq -c '
  [ .assets[]
    | select(.name | test("^niri-git-(?!debug-).*-(x86_64|znver3)\\.pkg\\.tar\\.zst$"))
  ] | first // empty
' <<< "$RELEASE_JSON")"

if [[ -z "$ASSET_JSON" ]]; then
  echo "❌ No matching package found in latest release."
  exit 1
fi

ASSET_URL="$(jq -r '.browser_download_url' <<< "$ASSET_JSON")"
PKG_FILE="$(jq -r '.name' <<< "$ASSET_JSON")"
EXPECTED_SHA256="$(jq -r '.digest // empty' <<< "$ASSET_JSON" | sed 's/^sha256://')"

# Extract version cleanly in pure bash
LATEST_VERSION="${PKG_FILE#niri-git-}"
LATEST_VERSION="${LATEST_VERSION%-x86_64.pkg.tar.zst}"
LATEST_VERSION="${LATEST_VERSION%-znver3.pkg.tar.zst}"

echo "Remote:  $LATEST_VERSION"
echo "------------------------------------------"

# Compare versions
UP_TO_DATE=false
if [[ -n "$INSTALLED_VERSION" ]] && [[ "$(vercmp "$INSTALLED_VERSION" "$LATEST_VERSION")" -ge 0 ]]; then
  UP_TO_DATE=true
fi

# -------------------------------
# Interactive Menu
# -------------------------------
if [[ "$AUTO_YES" == "false" && "$FORCE" == "false" ]]; then
  echo "Choose an action:"
  if [[ "$UP_TO_DATE" == "true" ]]; then
    echo "1) Update (Already latest: $INSTALLED_VERSION)"
  else
    echo "1) Update to $LATEST_VERSION"
  fi
  echo "2) Force reinstall"
  echo "3) Cancel"

  read -rp "Enter choice (1/2/3): " CHOICE

  case "$CHOICE" in
    1)
      if [[ "$UP_TO_DATE" == "true" ]]; then
        echo "✅ Already up to date."
        exit 0
      fi
      ;;
    2) FORCE=true ;;
    *) echo "Cancelled."; exit 0 ;;
  esac
fi

if [[ "$UP_TO_DATE" == "true" && "$FORCE" == "false" ]]; then
  echo "✅ Already up to date."
  exit 0
fi

# Authenticate sudo once upfront
sudo -v

# -------------------------------
# Download & Verify
# -------------------------------
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
cd "$TMP_DIR"

echo "⬇️ Downloading $PKG_FILE..."
aria2c -q --show-console-readout=true -x 8 -s 8 -k 1M -o "$PKG_FILE" "$ASSET_URL"

if [[ -n "$EXPECTED_SHA256" ]]; then
  echo "🔒 Verifying SHA-256 checksum..."
  echo "$EXPECTED_SHA256  $PKG_FILE" | sha256sum -c --status || {
    echo "❌ Checksum verification failed! Aborting install."
    exit 1
  }
fi

# -------------------------------
# Atomic Install / Conflict Swap
# -------------------------------
echo "📦 Installing..."
# Check exact package name (avoids matching niri-git via provides=('niri'))
for conflict in niri niri-bin; do
  if [[ "$(pacman -Q "$conflict" 2>/dev/null | awk '{print $1}')" == "$conflict" ]]; then
    sudo pacman -Rd --nodeps --noconfirm "$conflict"
  fi
done

sudo pacman -U --noconfirm "$PKG_FILE"

echo "------------------------------------------"
echo "✅ $PKG_NAME $LATEST_VERSION installed!"
echo "------------------------------------------"
